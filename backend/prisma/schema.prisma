generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                  Int                @id @default(autoincrement())
  nombre              String             @db.VarChar(120)
  correo              String             @unique(map: "correo") @db.VarChar(150)
  passwordHash        String             @map("password_hash") @db.VarChar(255)
  rol                 RolUsuario
  activo              Boolean            @default(true)
  creadoEn            DateTime           @default(now()) @map("creado_en") @db.DateTime(0)
  aprobacion          aprobacion[]
  auditoria_log       auditoria_log[]
  facturasRegistradas Factura[]          @relation("FacturaRegistradaPor")
  facturasVerificadas Factura[]          @relation("FacturaVerificadaPor")
  notificacion        notificacion[]
  otp_verificacion    otp_verificacion[]
  pago                Pago[]

  @@map("usuario")
}

model Proveedor {
  id        Int           @id @default(autoincrement())
  nombre    String        @db.VarChar(150)
  nit       String        @unique(map: "nit") @db.VarChar(20)
  tipo      TipoProveedor
  contacto  String?       @db.VarChar(120)
  telefono  String?       @db.VarChar(20)
  correo    String?       @db.VarChar(150)
  direccion String?       @db.VarChar(255)
  activo    Boolean       @default(true)
  creadoEn  DateTime      @default(now()) @map("creado_en") @db.DateTime(0)
  facturas  Factura[]

  @@map("proveedor")
}

model Factura {
  id                    Int              @id @default(autoincrement())
  proveedorId           Int              @map("proveedor_id")
  nitEmisor             String           @map("nit_emisor") @db.VarChar(20)
  nombreEmisor          String           @map("nombre_emisor") @db.VarChar(150)
  nitReceptor           String           @map("nit_receptor") @db.VarChar(20)
  nombreReceptor        String           @map("nombre_receptor") @db.VarChar(150)
  serie                 String?          @db.VarChar(50)
  registradoPor         Int              @map("registrado_por")
  numeroFactura         String           @map("numero_factura") @db.VarChar(50)
  montoTotal            Decimal          @map("monto_total") @db.Decimal(12, 2)
  montoAbonado          Decimal          @default(0.00) @map("monto_abonado") @db.Decimal(12, 2)
  saldoPendiente        Decimal          @map("saldo_pendiente") @db.Decimal(12, 2)
  fechaEmision          DateTime         @map("fecha_emision") @db.Date
  fechaVencimiento      DateTime         @map("fecha_vencimiento") @db.Date
  estadoAprobacion      EstadoAprobacion @default(pendiente) @map("estado_aprobacion")
  estadoPago            EstadoPago       @default(pendiente) @map("estado_pago")
  estadoOcr             EstadoOcr        @default(no_aplica) @map("estado_ocr")
  modalidadCompra       ModalidadCompra  @map("modalidad_compra")
  numeroAutorizacionSat String?          @map("numero_autorizacion_sat") @db.VarChar(50)
  verificadoSat         Boolean          @default(false) @map("verificado_sat")
  discrepanciaSat       Boolean          @default(false) @map("discrepancia_sat")
  verificadoPor         Int?             @map("verificado_por")
  fechaVerificacionSat  DateTime?        @map("fecha_verificacion_sat") @db.DateTime(0)
  categoriaGasto        String?          @map("categoria_gasto") @db.VarChar(80)
  adjuntoUrl            String?          @map("adjunto_url") @db.VarChar(255)
  creadoEn              DateTime         @default(now()) @map("creado_en") @db.DateTime(0)
  aprobacion            aprobacion[]
  proveedor             Proveedor        @relation(fields: [proveedorId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_factura_proveedor")
  registrador           Usuario          @relation("FacturaRegistradaPor", fields: [registradoPor], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_factura_usuario")
  verificador           Usuario?         @relation("FacturaVerificadaPor", fields: [verificadoPor], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_factura_verificador")
  notificacion          notificacion[]
  pagos                 Pago[]

  @@index([registradoPor], map: "fk_factura_usuario")
  @@index([verificadoPor], map: "fk_factura_verificador")
  @@index([discrepanciaSat], map: "idx_factura_discrepancia_sat")
  @@index([estadoAprobacion], map: "idx_factura_estado_aprobacion")
  @@index([estadoOcr], map: "idx_factura_estado_ocr")
  @@index([modalidadCompra], map: "idx_factura_modalidad_compra")
  @@index([proveedorId], map: "idx_factura_proveedor")
  @@index([fechaVencimiento], map: "idx_factura_vencimiento")
  @@index([verificadoSat], map: "idx_factura_verificado_sat")
  @@map("factura")
}

model Pago {
  id            Int      @id @default(autoincrement())
  facturaId     Int      @map("factura_id")
  registradoPor Int      @map("registrado_por")
  monto         Decimal  @db.Decimal(12, 2)
  fechaPago     DateTime @map("fecha_pago") @db.Date
  metodoPago    String?  @map("metodo_pago") @db.VarChar(50)
  observaciones String?  @db.VarChar(255)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.DateTime(0)
  factura       Factura  @relation(fields: [facturaId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_pago_factura")
  usuario       Usuario  @relation(fields: [registradoPor], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_pago_usuario")

  @@index([facturaId], map: "fk_pago_factura")
  @@index([registradoPor], map: "fk_pago_usuario")
  @@map("pago")
}

model aprobacion {
  id             Int                 @id @default(autoincrement())
  factura_id     Int
  aprobador_id   Int
  nivel          Int                 @db.TinyInt
  decision       aprobacion_decision
  comentario     String?             @db.VarChar(255)
  fecha_decision DateTime            @default(now()) @db.DateTime(0)
  factura        Factura             @relation(fields: [factura_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_aprobacion_factura")
  usuario        Usuario             @relation(fields: [aprobador_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_aprobacion_usuario")

  @@unique([factura_id, nivel], map: "uq_factura_nivel")
  @@index([aprobador_id], map: "fk_aprobacion_usuario")
}

model auditoria_log {
  id               Int                  @id @default(autoincrement())
  usuario_id       Int
  entidad_afectada String               @db.VarChar(30)
  entidad_id       Int
  accion           auditoria_log_accion
  campo_modificado String?              @db.VarChar(80)
  valor_anterior   String?              @db.VarChar(255)
  valor_nuevo      String?              @db.VarChar(255)
  fecha            DateTime             @default(now()) @db.DateTime(0)
  usuario          Usuario              @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_auditoria_usuario")

  @@index([fecha], map: "idx_auditoria_fecha")
  @@index([usuario_id], map: "idx_auditoria_usuario")
}

model notificacion {
  id         Int               @id @default(autoincrement())
  usuario_id Int
  factura_id Int?
  tipo       notificacion_tipo
  mensaje    String            @db.VarChar(255)
  leida      Boolean           @default(false)
  creado_en  DateTime          @default(now()) @db.DateTime(0)
  factura    Factura?          @relation(fields: [factura_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_notificacion_factura")
  usuario    Usuario           @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_notificacion_usuario")

  @@index([factura_id], map: "fk_notificacion_factura")
  @@index([usuario_id, leida], map: "idx_notificacion_usuario_leida")
}

model otp_verificacion {
  id                Int                     @id @default(autoincrement())
  usuario_id        Int
  accion            otp_verificacion_accion
  entidad_id        Int
  codigo_hash       String                  @db.VarChar(255)
  expira_en         DateTime                @db.DateTime(0)
  usado             Boolean                 @default(false)
  intentos_fallidos Int                     @default(0) @db.TinyInt
  creado_en         DateTime                @default(now()) @db.DateTime(0)
  usuario           Usuario                 @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_otp_usuario")

  @@index([usuario_id, accion], map: "idx_otp_usuario_accion")
}

enum RolUsuario {
  compras
  servicios
  administracion
}

enum TipoProveedor {
  bien
  servicio
}

enum EstadoAprobacion {
  pendiente
  aprobada
  rechazada
}

enum EstadoPago {
  pendiente
  parcial
  pagada
}

enum EstadoOcr {
  no_aplica
  procesando
  extraido_pendiente_revision
  verificado
}

enum ModalidadCompra {
  baja_cuantia
  compra_directa
  cotizacion
  licitacion
}

enum otp_verificacion_accion {
  pago
  marcar_pagada
  aprobacion
}

enum notificacion_tipo {
  vencimiento_proximo
  vencida
  aprobacion_pendiente
}

enum aprobacion_decision {
  aprobado
  rechazado
}

enum auditoria_log_accion {
  crear
  actualizar
  eliminar
}
